[resource]
script = ExtResource("2_god")
id = &"bathala"
display_name = "BATHALA"
epithet = "Ang Laro ng mga diyos"
color = Color(0.3, 0.31, 0.36, 1)
icon = ExtResource("3_wcu74")
game_name = "AGAWAN BASE"
game_blurb = "Bathala watches all. Two bases, yours and his, split by a common field. Tag the gods who hunt you - the same swing thaws a frozen ally - and hold his base to catch it. Do not let them touch yours."
arena_scene = "res://scenes/gods/bathala/BathalaArena.tscn"
implemented = true
favors = Array[ExtResource("1_favor")]([SubResource("Favor_partnership_mayari"), SubResource("Favor_partnership_apolaki"), SubResource("Favor_bathala_na"), SubResource("Favor_si_batman"), SubResource("Favor_half_vision_sacrifice"), SubResource("Favor_siblings_compromise_bathala")])
portrait = ExtResource("3_a85m2")
intro_lines = Array[String](["Ah, my little contenders. You've come a long way..", "And for what? The hand of one mortal?", "How curious. How very, very curious.", "Now then, let us see if you can take what you seek.", "Agawan Base! Your base against mine. Your mortals against my children.", "You wanted to prove yourselves worthy of Ines. Very well.", "Come and claim your victory, mortals.", "Let us see what you're willing to sacrifice."])
trial_end_lines = Array[String](["Well, well. It seems the mortals have given the heavens quite a show.", "You've fought, you've stumbled, and you've stolen a little FAVOR from the hands of the gods themselves.", "But tell me...", "Was it the FAVOR you sought?", "Or was it what you believed that FAVOR would buy you?", "[Bathala looks toward Ines.]", "Let us see, then, who among you has earned the heavens' favor.", "[FADE TO SCOREBOARD.]"])
success_lines = Array[String](["You defended your base and took mine. The gods keep their word. Your mortal goes free.", "Well played. Bathala is satisfied."])
failure_lines = Array[String](["Your base fell too often. Not yet - the gods are not finished watching you.", "Rise, and try Agawan Base again."])
transition_lines = {
"*": ["The field is yours now. Go well, mortal."]
}
