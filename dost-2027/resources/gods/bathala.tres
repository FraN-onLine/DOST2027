god_id = &"bathala"
display_name = "Our Partnership Ends Here (Mayari)"
description = "Lose 500 FAVOR now; every other mortal, your teammates included, is struck by Mayari's blindness for 10s. A blinded team is easier for the gods to beat. A favor is about sacrifice."
kind = 2
color = Color(0.55, 0.85, 1, 1)
icon = ExtResource("2_wcu74")
params = {
"blind_duration": 10.0,
"cost": 500
}

