[resource]
script = ExtResource("2_1yni8")
id = &"bathala"
display_name = "BATHALA"
epithet = "Ang Laro ng mga diyos"
color = Color(1, 0.95, 0.78, 1)
game_name = "THE FINAL CHALLENGE"
game_blurb = "Bathala judges the FAVOR you gathered from every god."
intro_lines = Array[String](["Bathala took the dearest of the mortals, convince him that they are ought to be released by getting FAVOR from God's challenges.", "FAVOR is the total points among all the challenges.", "You and fellow mortals take on a series of 4 to 6 challenges, and then one final challenge.", "Each god puts a Filipino sport in an arena and awards whoever entertained them the most.", "Every 1000 FAVOR you reach hands you a God's Due to spend on their favors.", "Play well. The gods are watching."])
success_lines = Array[String](["The gods keep their word. Your mortal goes free."])
failure_lines = Array[String](["Not yet. The gods are not finished watching you."])
