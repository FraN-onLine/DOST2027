[resource]
script = ExtResource("3_god")
id = &"tala"
display_name = "TALA"
epithet = "Goddess of the Stars"
color = Color(0.12, 0.22, 0.48, 1)
icon = ExtResource("3_pnj1g")
game_name = "TUMBANG PRESO"
game_blurb = "Throw slippers past Tala to knock down one of her guarded cans, then retrieve your slipper and return to the line."
arena_scene = "res://scenes/gods/tala/TalaArena.tscn"
implemented = true
favors = Array[ExtResource("1_favor")]([SubResource("Favor_bountiful_e"), SubResource("Favor_bountiful_q"), SubResource("Favor_shining"), SubResource("Favor_guidance"), SubResource("Favor_light_way"), SubResource("Favor_unbothered"), SubResource("Favor_last_light")])
portrait = ExtResource("4_pnj1g")
intro_lines = Array[String](["Tumbang Preso! A simple game of aim, timing, and a little bit of luck.", "Knock down the cans, but mind where you throw. I would hate to see you hit something... or someone... you didn't intend to.", "Now then, let's see if you can hit what you mean to hit, little mortals!"])
trial_end_lines = Array[String](["Splendid! Your aim has improved quite nicely.", "You know, the stars are rather particular about where they shine. Not everything that catches your eye is meant to be yours.", "Sometimes, you must learn to look carefully before you reach for something."])
success_lines = Array[String](["The game is done. The Favor you gathered will speak for you."])
failure_lines = Array[String](["The game is done. The Favor you gathered will speak for you."])
transition_lines = {
"apolaki": ["Brother, do mind your temper. These mortals are rather fragile compared to you."],
"bathala": ["Father awaits you now, little mortals. May the stars guide your steps... wherever they may lead."],
"hanan": ["Hanan, I'll leave them in your capable hands. Perhaps a little fresh air will do them good."],
"mapulon_ikapati": ["Uncle, Auntie, I'll leave these mortals to you. Do take good care of them."],
"mayari": ["Sister, do try to keep the darkness manageable. I'd hate for them to lose their way before they've had their fun."]
}
