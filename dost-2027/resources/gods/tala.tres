[resource]
script = ExtResource("3_god")
id = &"tala"
display_name = "TALA"
epithet = "Goddess of the Stars"
color = Color(0.12, 0.22, 0.48, 1)
icon = ExtResource("4_portrait")
game_name = "TUMBANG PRESO"
game_blurb = "Throw slippers past Tala to knock down one of her guarded cans, then retrieve your slipper and return to the line."
arena_scene = "res://scenes/gods/tala/TalaArena.tscn"
implemented = true
favors = Array[ExtResource("1_favor")]([SubResource("Favor_bountiful_e"), SubResource("Favor_bountiful_q"), SubResource("Favor_shining"), SubResource("Favor_guidance"), SubResource("Favor_light_way"), SubResource("Favor_unbothered")])
intro_lines = Array[String](["Tala watches the tin cans beneath the stars.", "Throw your slipper past me and strike a can. If I catch it, go fetch it from my side.", "Bring your slipper back to the line before you throw again."])
trial_end_lines = Array[String](["The cans settle. Keep the Favor you earned; the next game is ready."])
transition_lines = {
"apolaki": ["Apolaki, the players are coming to your arena.", "I will watch the next throw from the stars."],
"mayari": ["Mayari, the field belongs to you now.", "I will keep watch from above."],
"tala": ["The next round begins. The cans are set again."],
"bathala": ["Bathala, the mortals have played their games. Their Favor is yours to judge."]
}
success_lines = Array[String](["The game is done. The Favor you gathered will speak for you."])
failure_lines = Array[String](["The game is done. The Favor you gathered will speak for you."])