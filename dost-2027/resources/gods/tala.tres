[sub_resource type="Resource" id="Favor_bountiful_e"]
script = ExtResource("1_favor")
id = &"the_bountiful_e"
god_id = &"tala"
display_name = "The Bountiful (E)"
description = "Your E skill's cooldown is permanently reduced by 10%."
slot = 0
kind = 0
color = Color(0.2, 0.32, 0.62, 1)
icon = ExtResource("2_icon")
params = {"cooldown_multiplier": 0.9}

