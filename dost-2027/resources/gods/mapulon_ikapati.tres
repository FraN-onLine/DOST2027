"max_store": 400,
"store_fraction": 0.25
}

[resource]
script = ExtResource("3_god")
id = &"mapulon_ikapati"
display_name = "MAPULON & IKAPATI"
epithet = "The Harvest Pair"
color = Color(0.56, 0.78, 0.33, 1)
icon = ExtResource("2_icon")
game_name = "LANGIT LUPA"
game_blurb = "The Taya can only tag you on the Lupa, the ground - stand on a Langit and you are safe, but it crumbles behind you when you step off. When the Taya pulls off its RIGHT CLICK chant and yells ALIS!, everyone on a Langit must jump down and race to ANOTHER one before theirs crumbles. Every crossing earns FAVOR, more for a close call; get tagged and you are the Taya. Each season the Langit crumble and land somewhere new - and in the last 30 seconds Ikapati joins the hunt as a second Taya while the seasons race."
arena_scene = "res://scenes/gods/mapulon_ikapati/LangitLupaArena.tscn"
implemented = true
favors = Array[ExtResource("1_favor")]([SubResource("Favor_binhi"), SubResource("Favor_panahon_ng_anihan"), SubResource("Favor_kabiyak"), SubResource("Favor_tagtuyot"), SubResource("Favor_ligaw_na_damo"), SubResource("Favor_unang_ulan"), SubResource("Favor_kamalig")])
portrait = ExtResource("3_rcj6l")
intro_lines = Array[String](["Mapulon: Langit Lupa! A game of chasing, dodging, and finding your footing.", "Ikapati: Look after yourselves... and perhaps look after one another, too.", "Mapulon: Enough talk. Let's see how well you run!"])
trial_end_lines = Array[String](["Ikapati: Well done, dearies! You've certainly kept us entertained. We all seek somewhere safe to stand.", "Mapulon: Just remember that no ground stays firm forever.", "Ikapati: And no one should have to face every storm alone."])
success_lines = Array[String](["Mapulon: A good season.", "Ikapati: A full granary. We are proud of you."])
failure_lines = Array[String](["Ikapati: A thin harvest this time.", "Mapulon: Seasons turn. Plant again."])
transition_lines = {
"*": ["Ikapati: Go well, mortals. Eat before you play.", "Mapulon: And watch the sky."],
"apolaki": ["Mapulon: Apolaki, they're all yours. Try not to break anything we just finished growing.", "Ikapati: And do be gentle with them, dear. A little encouragement goes a long way."],
"bathala": ["Mapulon: Well, that's our part done. Lord Bathala will be waiting.", "Ikapati: Don't let the game become more important than the one you're playing it for."],
"hanan": ["Ikapati: Hanan, dear, it's your turn. Give these poor mortals a little sunshine.", "Mapulon: They've had enough running around for one day. Well... perhaps not."],
"mayari": ["Mapulon: Your turn, Mayari. Try not to send them running in circles all day.", "Ikapati: Oh, let them have a little fun, dear. Just don't let them forget where they're going."],
"tala": ["Ikapati: Tala, dear, do take good care of them.", "Mapulon: Though I suspect they'll be doing more running around than resting."]
}
speakers = {
"Ikapati": {
"color": Color(0.56, 0.78, 0.33, 1),
"portrait": ExtResource("3_rcj6l")
},
"Mapulon": {
"color": Color(0.45, 0.72, 0.92, 1),
"portrait": ExtResource("4_mapulon")
}
}
