[sub_resource type="Resource" id="Favor_kamalig"]
script = ExtResource("1_favor")
id = &"kamalig"
god_id = &"mapulon_ikapati"
display_name = "Kamalig (Ikapati)"
description = "Q - the granary. Store 25% of your FAVOR (at most 400) where nothing can touch it; it comes back with 20% interest when the trial ends. Stored FAVOR does not count as yours until then. Cooldown: 40s."
