[resource]
script = ExtResource("3_nxm4o")
id = &"apolaki"
display_name = "APOLAKI"
epithet = "God of the Sun and War"
color = Color(1, 0.85, 0.25, 1)
icon = ExtResource("3_c8kc2")
game_name = "ARNIS"
game_blurb = "Duel Apolaki one on one. Strike him while he is open, guard while he is not, and watch for his blind spots."
arena_scene = "res://scenes/gods/apolaki/ApolakiArena.tscn"
implemented = true
favors = Array[ExtResource("1_dp3kp")]([SubResource("Resource_c8kc2"), SubResource("Resource_gj13w"), SubResource("Resource_q3nb1"), SubResource("Resource_vs2ev"), SubResource("Resource_mua1f"), SubResource("Resource_0jkg1"), SubResource("Resource_3ahhg")])
portrait = ExtResource("4_nxm4o")
intro_lines = Array[String](["Arnis! Let's see if those arms of yours are good for anything other than boasting.", "Strike when you see an opening, defend when you must, and whatever you do, don't mistake my patience for weakness. Show me what makes you think you're worthy of Ines!"])
trial_end_lines = Array[String](["Hah! Not bad, mortals. You've got some fight in you after all.", "But strength isn't simply about how hard you can strike. It's knowing when to hold back... and when there's something worth taking a hit for.", "Keep that in mind. You'll need more than a strong arm to win this game."])
success_lines = Array[String](["You struck true. The sun saw it."])
failure_lines = Array[String](["Not enough fire in you yet."])
transition_lines = {
"bathala": ["They're holding up better than I expected, Father. Let's see if they're still standing when they reach you."],
"hanan": ["Give them a good fight, Hanan. They could use a little more practice."],
"mapulon_ikapati": ["Uncle, Auntie. Try not to coddle them too much. Let's see if they've got any backbone."],
"mayari": ["Hmph. Don't let my sister's tricks get to your heads. Keep your eyes open, and your feet moving."],
"tala": ["Try not to make this too easy on them, Tala. A little challenge never hurt anyone!"]
}
