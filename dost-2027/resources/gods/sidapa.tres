[resource]
script = ExtResource("2_god")
id = &"sidapa"
display_name = "SIDAPA"
epithet = "Lord of Mount Madja-as"
color = Color(0.42, 0.25, 0.55, 1)
icon = ExtResource("4_god")
game_name = "PIKO"
game_blurb = "Throw your stone onto one of the nine tiles, then hop the grid in order without touching a line and skip the tile your stone holds. Land clean and leap on; miss and lose FAVOR and start over from the throw. Touch the stone and hop back the way you came, picking it up on the last square. A countdown follows your head all the while - keep hopping to feed it."
arena_scene = "res://scenes/gods/sidapa/SidapaArena.tscn"
implemented = true
favors = Array[ExtResource("1_favor")]([SubResource("Favor_a_little_more_structure"), SubResource("Favor_a_little_more_control"), SubResource("Favor_departure_is_not_now"), SubResource("Favor_first_cleanse"), SubResource("Favor_lifeline"), SubResource("Favor_guilty_pleasure"), SubResource("Favor_time_is_now")])
portrait = ExtResource("4_god")
intro_lines = Array[String](["[The field goes cold. A single star burns above the grid, and the squares wait like open graves.]", "Piko. The little ones' game, played on the edge of my mountain.", "Throw your stone, hop the squares in order, and come back for it. Simple - if you do not look down.", "The sun is falling, mortals. Hop cleanly, or stay in the dark with me."])
trial_end_lines = Array[String](["You hopped well enough. The stone always comes home, in the end.", "I have watched every star burn out. You are brighter than most."])
success_lines = Array[String](["You leapt and returned and kept your stone. Even the underworld will remember your name."])
failure_lines = Array[String](["You stumbled on the lines. Do not worry - every grave is patient."])
transition_lines = {
"*": ["The field is cold now. Go, mortals."],
"apolaki": ["Apolaki, the sun is yours again. Do not burn what I have not yet buried."],
"bathala": ["Bathala waits, and Bathala does not wait kindly. Go."],
"hanan": ["Hanan, the morning comes. Let them wake."],
"mapulon_ikapati": ["Uncle, Auntie, the harvest is yours. They have earned their bread."],
"mayari": ["Mayari, the moon still remembers you. Go gently with them."],
"tala": ["Tala, the stars are yours. Light their way back."]
}
