[sub_resource type="Resource" id="Favor_the_west_wind"]
script = ExtResource("1_favor")
id = &"the_west_wind"
god_id = &"anitun_tabu"
display_name = "The West Wind"
description = "E - call the Winds and Gales of Yesterday onto the field for 5s, dragging every other mortal leftward. While you hold this favor the gales leave you untouched. Cast it while the wind already blows to gain 10% movement speed instead. Cooldown: 30s."
slot = 1
kind = 1
cooldown = 30.0
duration = 5.0
color = Color(0.38, 0.7, 0.84, 1)
icon = ExtResource("2_eln2r")
params = {
"gale_immunity": true,
"speed_boost": 0.1,
"wind_time": 5.0
}

