[resource]
script = ExtResource("2_god")
id = &"anitun_tabu"
display_name = "ANITUN TABU"
epithet = "Goddess of the Winds"
color = Color(0.38, 0.7, 0.84, 1)
icon = ExtResource("3_ucobq")
game_name = "LUKSONG LUBID"
game_blurb = "A lubid swings across the field from right to left and back again. Jump it with a click and land cleanly for FAVOR; touch it and lose FAVOR. Bursts of wind fall on and around you now and then - stand clear. When the Winds and Gales of Yesterday rise, the whole field drags you west; keep jumping, and the rope pays more."
arena_scene = "res://scenes/gods/anitun_tabu/LuksongLubidArena.tscn"
implemented = true
favors = Array[ExtResource("1_favor")]([SubResource("Favor_the_west_wind"), SubResource("Favor_mustve_been_the_wind"), SubResource("Favor_blow_back"), SubResource("Favor_a_silent_song"), SubResource("Favor_tabus_delivery_service"), SubResource("Favor_its_kinda_tabu"), SubResource("Favor_all_winds_lead_to_tabu")])
portrait = ExtResource("4_god")
intro_lines = Array[String](["[The field is restless. Dust lifts from the earth and hangs there, waiting.]", "The wind remembers every step the mortals ever took. Tonight it remembers yours.", "A lubid swings across the grass. Jump it, and the wind will sing for you. Touch it, and the wind will take its due.", "Blow true, little mortals. The west wind is already listening."])
trial_end_lines = Array[String](["The wind settles. You jumped well - most of you.", "Go now. The next gust will find you soon enough."])
success_lines = Array[String](["You danced with the wind and it let you pass. Even the gales will whisper your name."])
failure_lines = Array[String](["The wind took more than it gave. It usually does."])
transition_lines = {
"*": ["The air changes. Keep walking, and keep your feet under you."],
"apolaki": ["Apolaki, the sun still burns behind the wind. Go, and do not scorch what the breeze carried here."],
"bathala": ["Bathala waits beyond the last gust. The wind will not follow you there."],
"hanan": ["Hanan, the morning is yours. Let the air be still a while."],
"mapulon_ikapati": ["Uncle, Auntie, the harvest is yours. May the wind be gentle on it."],
"mayari": ["Mayari, the moon pulls the tides and the winds both. They are yours now."],
"tala": ["Tala, the stars are yours. Let the wind carry them somewhere kind."]
}
hidden_visitor = true
unknown_force_lines = Array[String](["Hmmm... another force rides the wind. It is not one of yours.", "The air thickens. Something old is coming - and it is not mine to name."])
