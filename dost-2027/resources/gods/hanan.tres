[resource]
script = ExtResource("3_god")
id = &"hanan"
display_name = "HANAN"
epithet = "Goddess of the Morning"
color = Color(1, 0.62, 0.55, 1)
icon = ExtResource("2_icon")
game_name = "LUKSONG BAKA"
game_blurb = "Run into Hanan's Baka and hold left click to leap over it - release and you fall. Keep your jump inside the glowing box while it drifts: a clean vault lands you on the other side and feeds your combo, then turn and vault back. Slip out of the box and you trip."
arena_scene = "res://scenes/gods/hanan/HananArena.tscn"
implemented = true
favors = Array[ExtResource("1_favor")]([SubResource("Favor_the_dawn"), SubResource("Favor_even_playing_field"), SubResource("Favor_first_light"), SubResource("Favor_bagong_umaga"), SubResource("Favor_break_of_day"), SubResource("Favor_morning_chases_the_night"), SubResource("Favor_the_three_sisters")])
portrait = ExtResource("3_ftwwg")
intro_lines = Array[String](["Luksong Baka! A game of timing, courage, and knowing when to take the leap.", "The higher the jump, the harder the landing. So don't be afraid to stumble, little mortals. Every morning begins anew.", "Now, take a deep breath... and jump!"])
trial_end_lines = Array[String](["Well done! Even when you stumbled, you found your footing again.", "Love can be much the same. Sometimes you leap without knowing where you'll land.", "And sometimes, the bravest thing you can do is begin again."])
success_lines = Array[String](["You leapt like the morning itself. Father should be proud."])
failure_lines = Array[String](["You tripped, but every dawn gets another try."])
transition_lines = {
"*": ["The morning is done. Go well, mortals."],
"apolaki": ["Apolaki, please try not to push them too hard. They have already come a long way."],
"bathala": ["Father is waiting for you now. Whatever happens next, I hope they find what their hearts are looking for."],
"mapulon_ikapati": ["Uncle, Auntie, I hope you'll give them a chance to catch their breath. They've certainly earned one."],
"mayari": ["Mayari, do keep an eye on these mortals. They may need a little guidance when the lights go out."],
"tala": ["Tala, I'll leave them to you. May they find their aim, even if they stumble along the way."]
}
