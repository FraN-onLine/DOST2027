[resource]
script = ExtResource("3_nlsjc")
id = &"mayari"
display_name = "MAYARI"
epithet = "Goddess of the Moon"
color = Color(0.55, 0.85, 1, 1)
icon = ExtResource("3_0nofr")
game_name = "PATINTERO"
game_blurb = "Four boxes sit on the field and Mayari lights one at a time. Stand in the lit box and hold it while her two clones walk the lines drawn for them - every so often one hunts the nearest mortal - and let one touch you and you pay for it."
arena_scene = "res://scenes/gods/mayari/MayariArena.tscn"
implemented = true
favors = Array[ExtResource("1_kov66")]([SubResource("Resource_0nofr"), SubResource("Resource_ib605"), SubResource("Resource_yboih"), SubResource("Resource_su3vm"), SubResource("Resource_5h57l"), SubResource("Resource_t3u61"), SubResource("Resource_moon1")])
portrait = ExtResource("3_v7yr7")
intro_lines = Array[String](["Patintero is our game, Go and get my favor by Targeting the golden square.", "Simple? Remember, there is ONLY ONE VICTOR in the battlefields. But remember, No horseplay children~ wink wink-"])
trial_end_lines = Array[String](["Well done! You have certainly entertained me. Love is such a beautiful thing to fight for, isn't it?", "But do be careful, little mortals. There's a difference between fighting for someone...", "...and fighting because you believe you must win them.", "Compromise is a wonderful thing. It is best practiced before anyone gets hurt. Wink wink-"])
success_lines = Array[String](["You moved like moonlight on water. The moon remembers this."])
failure_lines = Array[String](["Hm. The night is long - try again before the moon sets."])
transition_lines = {
"apolaki": ["Alright.. Don’t hurt these poor souls now Apolaki"],
"bathala": ["Hmm.. Our Father is waiting for you, He’s never been fond of losing.. Goodluck~"],
"hanan": ["Your next challenge should be easy, You rest your pretty little head now for Hanan"],
"mapulon_ikapati": ["Uncle and Auntie, Do these two good now will you"],
"sidapa": ["Sidapa... the moon and the grave have never been friends. Still, do not be cruel to them."],
"tala": ["Gentle now, sister Tala."]
}
