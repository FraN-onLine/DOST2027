anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -272.0
offset_right = 300.0
offset_bottom = 272.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_opts")
